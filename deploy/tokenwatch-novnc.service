[Unit]
Description=Tokenwatch local noVNC server
After=tokenwatch-x11vnc.service
Requires=tokenwatch-x11vnc.service

[Service]
User=tokenwatch
Environment=HOME=/opt/tokenwatch
ExecStart=/usr/bin/websockify --web /usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900
Restart=on-failure

[Install]
WantedBy=multi-user.target
